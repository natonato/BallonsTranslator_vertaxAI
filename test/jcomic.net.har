            "mimeType": "text/html",
            "text": "\r\n<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n\t<!-- Google tag (gtag.js) -->\r\n\t<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-QL6YSDRWEV\"></script>\r\n\t<script>\r\n\t  window.dataLayer = window.dataLayer || [];\r\n\t  function gtag(){dataLayer.push(arguments);}\r\n\t  gtag('js', new Date());\r\n\r\n\t  gtag('config', 'G-QL6YSDRWEV');\r\n\t</script>\r\n    <meta charset=\"utf-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n\t<meta charset=\"UTF-8\">\r\n\t<meta name=\"description\" content=\"h漫分享小站\">\r\n\t<meta name=\"keywords\" content=\"h漫,嗶咔,18h,紳士,成人漫畫,H圖,H本子,j圖, pica\">\r\n\t<meta name=\"juicyads-site-verification\" content=\"92d1559a83b75fab2761a7256444d42d\"><!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->\r\n\t<meta name=\"Trafficstars\" content=\"86195\">\r\n\t<meta name=\"95a281dba6bf112f69068dcdcd0cbf6b184a7f69\" content=\"95a281dba6bf112f69068dcdcd0cbf6b184a7f69\" />\r\n\t<meta name=\"referrer\" content=\"no-referrer-when-downgrade\" />\r\n    <title>JComic</title>\r\n\r\n    <!-- Bootstrap Core CSS -->\r\n    <link href=\"/view/css/bootstrap.min.css?aa\" rel=\"stylesheet\">\r\n\t<!-- Custom CSS: You can use this stylesheet to override any Bootstrap styles and/or apply your own styles -->\r\n    <link href=\"/view/css/custom.css?20220214\" rel=\"stylesheet\">\r\n\t<!--<link rel=\"preload\" href=\"/view/fonts/glyphicons-halflings-regular.woff2\" as=\"font\" type=\"font/woff2\" crossorigin=\"anonymous\">-->\r\n\r\n\t\r\n\t<script src=\"/view/jquery.js\"></script>\r\n\t<script src=\"/view/jquery.lazyload.js\"></script>\r\n\t<script type=\"text/javascript\" data-cfasync=\"false\" async src=\"https://poweredby.jads.co/js/jads.js\"></script>\r\n\t<script>\r\n\t  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\r\n\t  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\r\n\t  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\r\n\t  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');\r\n\r\n\t  ga('create', 'UA-87476157-1', 'auto');\r\n\t \r\n\tga('send', 'pageview');\t  \r\n\t  \r\n\t  \r\n\t$(function() {\r\n\t\t$(\"img.lazy\").lazyload({\r\n\t\t\tthreshold : 5000\r\n\t\t});\r\n\t});\r\n\t\r\n\t/*\r\n\tvar mq = window.matchMedia(\"(min-width: 800px)\");\r\n\t//var mq2 = window.matchMedia(\"(max-width: 799px)\");\r\n\r\n\t mq.addListener(WidthChange);\r\n\t //mq2.addListener(WidthChange);\r\n\t// media query event handler\r\n\t$( document ).ready(function() {\r\n\tif (matchMedia) {\r\n\t  WidthChange(mq);\r\n\t}\r\n\t});\r\n\t*/\r\n\r\n\t// media query change\r\n\t/*\r\n\tfunction WidthChange(mq) {\r\n\t  if (mq.matches) {\r\n\t\t$( \".adbannerD\" ).css({'display':'block'});\r\n\t\t$( \".adbannerM\" ).css({'display':'none'});\r\n\t\t\r\n\t\tconsole.log(\"desktop\");\r\n\r\n\t  } else {\r\n\t\t$( \".adbannerM\" ).css({'display':'block'});\r\n\t\t$( \".adbannerD\" ).css({'display':'none'});\r\n\t\t\r\n\t\tconsole.log(\"mobile\");\r\n\t  }\r\n\r\n\t}\r\n\t*/\r\n\tfunction search(){\r\n\tvar search = document.getElementById('search').value;\r\n\tif (search)\r\n\t\twindow.location = '/search/'+search;\r\n\t}\r\n\tfunction setCookie(cname, cvalue, exdays) {\r\n\t  const d = new Date();\r\n\t  d.setTime(d.getTime() + (exdays*24*60*60*1000));\r\n\t  let expires = \"expires=\"+ d.toUTCString();\r\n\t  document.cookie = cname + \"=\" + cvalue + \";\" + expires + \";path=/\";\r\n\t}\r\n\tfunction getCookie(cname) {\r\n\t  let name = cname + \"=\";\r\n\t  let decodedCookie = decodeURIComponent(document.cookie);\r\n\t  let ca = decodedCookie.split(';');\r\n\t  for(let i = 0; i <ca.length; i++) {\r\n\t\tlet c = ca[i];\r\n\t\twhile (c.charAt(0) == ' ') {\r\n\t\t  c = c.substring(1);\r\n\t\t}\r\n\t\tif (c.indexOf(name) == 0) {\r\n\t\t  return c.substring(name.length, c.length);\r\n\t\t}\r\n\t  }\r\n\t  return \"\";\r\n\t}\r\n\t</script>\r\n\r\n<script>\r\ndocument.addEventListener(\"DOMContentLoaded\", function() {\r\n    // Set up the Intersection Observer\r\n    // rootMargin \"800px\" means: \"Start decoding and downloading when the image is 800 pixels away from the screen\"\r\n    const imageObserver = new IntersectionObserver((entries, observer) => {\r\n        entries.forEach(entry => {\r\n            if (entry.isIntersecting) {\r\n                let img = entry.target;\r\n                let lockedStr = img.getAttribute('data-locked');\r\n                \r\n                if (lockedStr) {\r\n                    try {\r\n                        // 1. Strip the junk prefix\r\n                        let cleanStr = lockedStr.replace(\"JCOMIC_TRAP_\", \"\");\r\n                        \r\n                        // 2. Reverse back to Base64\r\n                        let unreversed = cleanStr.split('').reverse().join('');\r\n                        \r\n                        // 3. Decode and load the image\r\n                        img.src = atob(unreversed);\r\n                        \r\n                        // Clean up\r\n                        img.removeAttribute('data-locked');\r\n                    } catch (error) {\r\n                        console.error(\"Failed to unlock image.\");\r\n                    }\r\n                }\r\n                \r\n                // Stop observing the image once it has been triggered\r\n                observer.unobserve(img);\r\n            }\r\n        });\r\n    }, { rootMargin: \"800px 0px 800px 0px\" });\r\n\r\n    // Find all protected images and attach the observer\r\n    const images = document.querySelectorAll('.jcomic-img');\r\n    images.forEach(img => {\r\n        imageObserver.observe(img);\r\n    });\r\n});\r\n</script>\r\n</head>\r\n <!-- Navigation -->\r\n    <nav class=\"navbar navbar-inverse navbar-fixed-top\" role=\"navigation\">   \r\n\t\r\n        <div class=\"container\">\r\n            <!-- Logo and responsive toggle -->\r\n            <div class=\"navbar-header\">\r\n                \r\n                <a class=\"navbar-brand d-none\" href=\"/\">\r\n                \t<span class=\"glyphicon glyphicon-fire\"></span> \r\n                \tJComic\r\n                </a>\r\n\t\t\t\t<div class=\"form-inline navbar-right\" style=\"display:flex\">\r\n\t\t\t\t\t<input class=\"form-control\" type=\"search\" id=\"search\" name=\"search\" placeholder=\"Search\" aria-label=\"Search\">\r\n\t\t\t\t\t<button class=\"btn btn-outline-success my-2 my-sm-0\" id=\"search-btn\" onclick=\"search();\">Search</button>\r\n\t\t\t\t  </div>\r\n\t\t\t\t  \r\n            </div>\r\n\t\t\t\r\n            <!-- Navbar links -->\r\n\t\t\t\r\n            <div class=\"collapse navbar-collapse\" id=\"bs-example-navbar-collapse-1\">\r\n\r\n                <ul class=\"nav navbar-nav navbar-right\">\r\n                    <li>\r\n                        \r\n                    </li>\r\n                </ul>\r\n\t\t\t\t\r\n            </div>\r\n\t\t\t\r\n            <!-- /.navbar-collapse -->\r\n        </div>\r\n        <!-- /.container -->\r\n    </nav>\r\n\n\n\n<body>\n    <!-- Content -->\n    <div class=\"container\">\n\n        <!-- Heading -->\n        <div class=\"row\">\n            <div class=\"col-lg-12\">\n                <h1 class=\"page-header\">歡迎光臨 JComic.net\n                 </h1>\n\t\t\t</div>\n        </div>\n\t\t<div class=\"row\">\n\t\t<div class=\"col-sm-12 col-xm-12 col-centered adbannerD\" style=\"padding-top:5px\">\r\n\t\t\t<!-- JuicyAds v3.0 -->\r\n\t\t\t<script type=\"text/javascript\" data-cfasync=\"false\" async src=\"https://poweredby.jads.co/js/jads.js\"></script><ins id=\"552737\" data-width=\"728\" data-height=\"102\"></ins>\r\n\t\t\t<script type=\"text/javascript\" data-cfasync=\"false\" async>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':552